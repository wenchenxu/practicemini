.page {
    padding: 16rpx;
  }
  
  .section {
    margin-bottom: 32rpx;
    padding: 20rpx;
    border-radius: 12rpx;
    background-color: #ffffff;
    box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
  }
  
  .section-title {
    font-weight: 600;
    margin-bottom: 12rpx;
    font-size: 30rpx;
  }

  /* 司机证件照 */
  .docs-empty {
    color: #999;
    font-size: 26rpx;
    padding: 10rpx 0;
  }

  .docs-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
    margin-top: 10rpx;
  }

  .docs-cell {
    width: calc(50% - 8rpx);
    box-sizing: border-box;
  }

  .docs-img {
    width: 100%;
    height: 190rpx;
    border-radius: 10rpx;
    background: #f5f5f5;
    display: block;
  }

  .docs-label {
    font-size: 22rpx;
    color: #666;
    text-align: center;
    margin-top: 8rpx;
  }
  