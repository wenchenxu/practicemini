page {
  background-color: #F6F7F9;
  color: #333;
}
.container {
  padding: 24rpx;
  padding-bottom: 120rpx;
}
.section-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  color: #222;
  border-left: 8rpx solid #1677ff;
  padding-left: 16rpx;
  line-height: 1;
}
.row-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.row-picker.no-border {
  border-bottom: none;
}
.row-label {
  font-size: 28rpx;
  color: #333;
  width: 180rpx;
}
.picker-flex {
  flex: 1;
  text-align: right;
}
.picker-text {
  font-size: 28rpx;
  color: #333;
}
.picker-text.placeholder {
  color: #ccc;
}
.row-arrow {
  color: #ccc;
  font-size: 32rpx;
  margin-left: 12rpx;
  font-family: monospace;
}
.form-wrap {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.form-item {
  width: 100%;
  margin-bottom: 28rpx;
}
.item-contractValidPeriodStart,
.item-contractValidPeriodEnd {
  width: 48%;
}
.item-rentMonthly,
.item-rentToday {
  width: 48%;
}
.item-deposit,
.item-depositToday {
  width: 48%;
}
.label {
  display: block;
  font-size: 26rpx;
  color: #555;
  margin-bottom: 12rpx;
}
.req {
  color: #e5484d;
  margin-right: 4rpx;
}
.tip {
  color: #999;
  font-size: 22rpx;
  margin-left: 6rpx;
}
.input-box {
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  height: 48rpx;
  line-height: 48rpx;
}
.input-box.ph {
  color: #ccc;
}
.picker-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.date-icon {
  font-size: 24rpx;
  filter: grayscale(1);
  opacity: 0.5;
}
.footer-actions {
  margin-top: 40rpx;
}
.submit-btn {
  border-radius: 999rpx;
  font-weight: 600;
  font-size: 32rpx;
  box-shadow: 0 6rpx 16rpx rgba(22, 119, 255, 0.2);
}
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.header-tag {
  font-size: 40rpx;
  font-weight: bold;
}
.header-info {
  text-align: right;
}
.type-text {
  font-size: 28rpx;
  color: #52c41a;
  font-weight: bold;
}
